DATABASE_URL="postgresql://academy:academy_dev_password@localhost:5432/academy"
SESSION_SECRET="dev-session-secret-change-in-production"
# --- Optional provider credentials (leave empty in dev; features degrade gracefully) ---
# Video conferencing (Daily.co) — Live Calls run in embedded rooms when configured
DAILY_API_KEY=""
DAILY_DOMAIN=""
# Zoom (Server-to-Server OAuth) — academy-wide fallback credentials. Staff can also connect
# their own Zoom account on their profile; everything they host then uses that instead.
# Live calls (one-off and repeating) and 1-on-1 bookings get Zoom meetings when either is set.
# Create the app at marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth,
# with scopes meeting:write:admin, meeting:update:admin and meeting:delete:admin.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
# Email (or user id) of the licensed Zoom user meetings are created under by default.
# Hosts with their own Zoom seat can override this in 1-on-1s → Manage availability.
ZOOM_USER_ID=""
# Key for encrypting credentials people store in their account (per-user Zoom secrets).
# Falls back to SESSION_SECRET when empty; changing it means people re-enter their secrets.
CREDENTIALS_SECRET=""
# Email (Resend) — password reset + notification emails when configured
RESEND_API_KEY=""
EMAIL_FROM=""
# Object storage (S3-compatible) — falls back to local ./storage dir in dev.
# Required in production for direct video uploads (browser uploads via
# presigned URLs; the bucket CORS policy must allow PUT from the app origin).
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
DEMO_MODE="true"
