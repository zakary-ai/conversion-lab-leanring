generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Users, auth, roles
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  LEARNER
  // Future: EMPLOYER / RECRUITER can be added without schema rebuild
  EMPLOYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  // Optional so admins can add people by access code before they have an email
  email        String?    @unique
  passwordHash String
  name         String
  // Sign-in access code (normalized, no dashes) for email-less accounts
  accessCode   String?    @unique
  role         Role       @default(LEARNER)
  status       UserStatus @default(ACTIVE)
  // Cached star balance — the StarTransaction ledger is the source of truth.
  starBalance  Int        @default(0)
  // IANA zone chosen during onboarding (or on the profile). Null = not set yet;
  // the UI then falls back to the browser zone. Source of truth for
  // HostAvailability.timezone and Booking.learnerTz — see lib/user-timezone.ts.
  timezone     String?
  onboardedAt  DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile             Profile?
  sessions            Session[]
  passwordResets      PasswordResetToken[]
  starTransactions    StarTransaction[]     @relation("StarTxUser")
  starTxCreated       StarTransaction[]     @relation("StarTxCreator")
  enrollments         Enrollment[]
  lessonProgress      LessonProgress[]
  quizAttempts        QuizAttempt[]
  channelMemberships  ChannelMembership[]
  messages            Message[]
  messageReactions    MessageReaction[]
  dmParticipants      DmParticipant[]
  dmMessages          DmMessage[]
  callAttendees       CallAttendee[]
  hostedCalls         LiveCall[]            @relation("CallHost")
  hostedSeries        CallSeries[]          @relation("CallSeriesHost")
  hostAvailability    HostAvailability?
  zoomConnection      ZoomConnection?
  hostedBookings      Booking[]             @relation("BookingHost")
  bookings            Booking[]             @relation("BookingLearner")
  notifications       Notification[]
  auditLogs           AuditLog[]            @relation("AuditActor")
  moderationActions   ModerationAction[]    @relation("ModerationActor")
  moderationReceived  ModerationAction[]    @relation("ModerationTarget")
  unlockEvents        UnlockEvent[]
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline      String?
  bio           String?
  location      String?
  avatarUrl     String?
  salesExperience String?
  skills        String[] @default([])
  resumeUrl     String?
  linkedinUrl   String?
  videoIntroUrl String?
  availability  String?
  updatedAt     DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// Star ledger — source of truth for progression
// ─────────────────────────────────────────────────────────────

enum StarTxType {
  AUTOMATIC_REWARD
  MANUAL_AWARD
  MANUAL_DEDUCTION
  ADMINISTRATIVE_CORRECTION
}

model StarTransaction {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation("StarTxUser", fields: [userId], references: [id], onDelete: Cascade)
  amount          Int // positive or negative
  type            StarTxType
  // What triggered an automatic award, e.g. "module" / moduleId or "quiz" / quizId
  sourceType      String?
  sourceId        String?
  reason          String
  previousBalance Int
  newBalance      Int
  createdById     String?
  createdBy       User?      @relation("StarTxCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())

  // Prevents the same automatic milestone from paying out twice.
  @@unique([userId, sourceType, sourceId, type], name: "uniqueAutomaticReward")
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Training: courses → modules → lessons
// ─────────────────────────────────────────────────────────────

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Course {
  id           String        @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String?
  status       PublishStatus @default(DRAFT)
  minStars     Int           @default(0)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  modules     Module[]
  enrollments Enrollment[]
}

model Module {
  id            String        @id @default(cuid())
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        PublishStatus @default(DRAFT)
  minStars      Int           @default(0)
  sortOrder     Int           @default(0)
  // Stars automatically awarded when the module (all required lessons + quiz) is completed
  starReward    Int           @default(0)
  // Optional prerequisite module that must be completed first
  prerequisiteId String?
  prerequisite  Module?       @relation("ModulePrereq", fields: [prerequisiteId], references: [id], onDelete: SetNull)
  dependents    Module[]      @relation("ModulePrereq")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lessons Lesson[]
  quizzes Quiz[]
}

enum LessonType {
  VIDEO
  TEXT
  DOCUMENT
  LINK
}

model Lesson {
  id          String        @id @default(cuid())
  moduleId    String
  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        LessonType    @default(VIDEO)
  // Video lessons reference a VideoAsset through the provider abstraction
  videoAssetId String?
  videoAsset  VideoAsset?   @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  // Text lessons store rich text content
  content     String?
  // Document / link lessons
  fileUrl     String?
  linkUrl     String?
  durationMin Int?
  status      PublishStatus @default(DRAFT)
  required    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  progress  LessonProgress[]
  resources LessonResource[]
}

model LessonResource {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title    String
  url      String
  kind     String @default("file") // file | link
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Video assets via provider abstraction
// ─────────────────────────────────────────────────────────────

model VideoAsset {
  id           String   @id @default(cuid())
  title        String
  description  String?
  // Provider abstraction: "url" (external/embed), "file" (local/object storage), "mux", "youtube", "vimeo" ...
  provider     String   @default("url")
  // Provider-specific reference: URL, storage key, or provider asset id
  reference    String
  thumbnailUrl String?
  durationSec  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lessons Lesson[]
}

// ─────────────────────────────────────────────────────────────
// Quizzes
// ─────────────────────────────────────────────────────────────

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  // Architected for later: SHORT_ANSWER, ORDERING, etc.
}

model Quiz {
  id           String        @id @default(cuid())
  moduleId     String
  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  passingScore Int           @default(80) // percentage
  allowRetry   Boolean       @default(true)
  maxAttempts  Int? // null = unlimited
  status       PublishStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType @default(MULTIPLE_CHOICE)
  prompt      String
  explanation String?
  sortOrder   Int          @default(0)

  answers QuizAnswer[]
}

model QuizAnswer {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  sortOrder  Int          @default(0)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int // percentage
  passed      Boolean
  // Answers snapshot: { [questionId]: string[] of chosen answerIds }
  responses   Json
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, quizId])
}

// ─────────────────────────────────────────────────────────────
// Community channels
// ─────────────────────────────────────────────────────────────

enum ChannelSection {
  COMMUNITY
  ADVANCED
  STAFF
}

model Channel {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String?
  section     ChannelSection @default(COMMUNITY)
  minStars    Int            @default(0)
  // Minimum role required, null = any role. Stored as Role name for staff channels.
  minRole     Role?
  readOnly    Boolean        @default(false)
  isPrivate   Boolean        @default(false) // private = membership required
  hidden      Boolean        @default(false) // fully hidden when locked (default is visible-but-locked)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())

  memberships ChannelMembership[]
  messages    Message[]
}

model ChannelMembership {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  lastReadAt DateTime @default(now())

  @@unique([channelId, userId])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  // Threaded replies
  parentId  String?
  parent    Message?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Message[] @relation("Thread")
  pinned    Boolean   @default(false)
  attachmentUrl String?
  attachmentName String?
  editedAt  DateTime?
  deletedAt DateTime?
  deletedById String?
  createdAt DateTime  @default(now())

  reactions MessageReaction[]

  @@index([channelId, createdAt])
}

model MessageReaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([messageId, userId, emoji])
}

// ─────────────────────────────────────────────────────────────
// Direct messages (architected for future group DMs)
// ─────────────────────────────────────────────────────────────

model DmConversation {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  title     String? // for future group DMs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants DmParticipant[]
  messages     DmMessage[]
}

model DmParticipant {
  id             String         @id @default(cuid())
  conversationId String
  conversation   DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime       @default(now())
  joinedAt       DateTime       @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model DmMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Live calls
// ─────────────────────────────────────────────────────────────

enum CallStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveCall {
  id            String     @id @default(cuid())
  title         String
  description   String?
  hostId        String?
  host          User?      @relation("CallHost", fields: [hostId], references: [id], onDelete: SetNull)
  scheduledAt   DateTime
  durationMin   Int        @default(60)
  minStars      Int        @default(0)
  maxAttendees  Int?
  recordingEnabled Boolean @default(false)
  relatedModuleId String?
  status        CallStatus @default(SCHEDULED)
  // Provider abstraction: room reference from the configured RTC provider
  // (embedded Daily.co rooms). Unused when the call is hosted on Zoom.
  providerRoomId String?
  // Occurrence of a recurring series (null for one-off calls). The original
  // slot from the rule is kept in seriesSlot even if this occurrence is moved.
  seriesId      String?
  series        CallSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesSlot    DateTime?
  // Meeting provider (Zoom built in). One-off calls own a meeting; series
  // occurrences share the series meeting and carry their Zoom occurrence id.
  // Null when the call runs in an embedded room or no provider is configured.
  meetingProvider     String?
  meetingId           String?
  meetingOccurrenceId String?
  joinUrl             String?
  startUrl            String?
  // ZoomConnection the meeting was created with; null = academy-wide env credentials
  meetingConnectionId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  attendees  CallAttendee[]
  recordings CallRecording[]

  @@index([seriesId, scheduledAt])
}

enum CallSeriesStatus {
  ACTIVE
  CANCELLED
}

// A repeating live call. The rule is weekly: on `daysOfWeek` (0 = Sunday),
// every `intervalWeeks`, at `startMinute` past midnight in `timezone`, from
// `startsOn` through `endsOn` (calendar dates in that zone, "YYYY-MM-DD").
// Every occurrence is created up front as a LiveCall (see lib/call-series.ts),
// so RSVPs, star gates, recordings and notifications need no special cases.
// When Zoom is configured the series is one Zoom recurring meeting.
model CallSeries {
  id               String           @id @default(cuid())
  title            String
  description      String?
  hostId           String?
  host             User?            @relation("CallSeriesHost", fields: [hostId], references: [id], onDelete: SetNull)
  timezone         String
  daysOfWeek       Int[]
  intervalWeeks    Int              @default(1)
  startMinute      Int
  startsOn         String
  endsOn           String
  durationMin      Int              @default(60)
  minStars         Int              @default(0)
  maxAttendees     Int?
  recordingEnabled Boolean          @default(false)
  status           CallSeriesStatus @default(ACTIVE)
  meetingProvider  String?
  meetingId        String?
  joinUrl          String?
  startUrl         String?
  // ZoomConnection the meeting was created with; null = academy-wide env credentials
  meetingConnectionId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  calls LiveCall[]
}

model CallAttendee {
  id       String   @id @default(cuid())
  callId   String
  call     LiveCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvpAt   DateTime @default(now())
  joinedAt DateTime?

  @@unique([callId, userId])
}

model CallRecording {
  id          String        @id @default(cuid())
  callId      String
  call        LiveCall      @relation(fields: [callId], references: [id], onDelete: Cascade)
  title       String
  url         String
  minStars    Int           @default(0)
  status      PublishStatus @default(DRAFT)
  recordedAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
}

// ─────────────────────────────────────────────────────────────
// 1-on-1 bookings (Calendly-style)
// ─────────────────────────────────────────────────────────────

// Per-host booking preferences. One row per staff member who has opened the
// availability editor. Weekly windows live in AvailabilityWindow.
model HostAvailability {
  id                String   @id @default(cuid())
  hostId            String   @unique
  host              User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  // IANA zone the weekly windows are expressed in
  timezone          String   @default("America/New_York")
  slotMinutes       Int      @default(30)
  minNoticeMinutes  Int      @default(120)
  acceptingBookings Boolean  @default(false)
  // Zoom user (email or id) meetings are created under when using the
  // academy-wide credentials; null = ZOOM_USER_ID env. Ignored when the host
  // has their own ZoomConnection.
  zoomUserId        String?
  updatedAt         DateTime @updatedAt

  windows AvailabilityWindow[]
}

// A staff member's own Zoom account (Server-to-Server OAuth app). When set,
// meetings for calls and 1-on-1s they host are created with these credentials
// instead of the academy-wide ZOOM_* env vars. The client secret is encrypted
// at rest (lib/secrets.ts); the other fields are identifiers, not secrets.
model ZoomConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String
  clientId        String
  clientSecretEnc String
  // Email (or id) of the licensed Zoom user meetings are created under
  zoomUserId      String
  // Last time the credentials were checked against Zoom successfully
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Weekly recurring window in the host's local timezone, minutes since midnight.
model AvailabilityWindow {
  id             String           @id @default(cuid())
  availabilityId String
  availability   HostAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 0 = Sunday … 6 = Saturday
  startMinute    Int // 0..1439
  endMinute      Int // 1..1440, > startMinute

  @@index([availabilityId, dayOfWeek])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  hostId      String
  host        User          @relation("BookingHost", fields: [hostId], references: [id], onDelete: Cascade)
  learnerId   String
  learner     User          @relation("BookingLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  durationMin Int
  // Browser timezone at booking time (for display / future email reminders)
  learnerTz   String
  note        String?
  status      BookingStatus @default(CONFIRMED)
  // "<hostId>|<startsAt ISO>" while CONFIRMED, null once cancelled. Postgres
  // allows many NULLs in a unique column, so a cancelled slot frees up while a
  // live booking still blocks a second booking of the same slot.
  slotKey       String?   @unique
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?
  // Meeting provider abstraction (Zoom built in). Null when unconfigured/failed.
  meetingProvider String?
  meetingId       String?
  joinUrl         String?
  startUrl        String?
  // ZoomConnection the meeting was created with; null = academy-wide env credentials
  meetingConnectionId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([hostId, startsAt])
  @@index([learnerId, startsAt])
  @@index([status, startsAt])
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  STAR_EARNED
  CONTENT_UNLOCKED
  QUIZ_RESULT
  MODULE_AVAILABLE
  CALL_UPCOMING
  CALL_STARTING
  NEW_DM
  MENTION
  REPLY
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  // Architected so email/push delivery can be layered on later
  emailedAt DateTime?
  pushedAt  DateTime?

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Records shown in "Recently unlocked" — written when a star change makes new content eligible
model UnlockEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String // course | module | channel | call | recording
  entityId   String?
  title      String
  atStars    Int
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Moderation, audit, settings
// ─────────────────────────────────────────────────────────────

model ModerationAction {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetId  String?
  target    User?    @relation("ModerationTarget", fields: [targetId], references: [id], onDelete: SetNull)
  action    String // delete_message | pin_message | mute_user | report | escalate
  entityType String?
  entityId  String?
  reason    String?
  expiresAt DateTime? // for mutes
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. star.award, user.suspend, module.publish, booking.create
  entityType String?
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Admin-configurable platform settings (key-value, typed at the app layer)
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Admin-defined star rules for future milestone types (beyond module completion)
model StarRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  // trigger: module_complete | quiz_pass | path_complete | custom
  trigger     String
  targetType  String?
  targetId    String?
  starAmount  Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Future gamification: achievements (not exposed in MVP UI)
model Achievement {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  iconKey     String?
  active      Boolean @default(false)
}
